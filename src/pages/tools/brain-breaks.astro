---
import Layout from '../../layouts/Layout.astro';

const title = 'Brain Breaks Wheel — Austin McNair';
const description =
  'A free, browser-based brain breaks wheel for K–8 classrooms. Twelve brain breaks, spun at random — physical, academic, social, or games. Sourced from Inclusion Rules.';
---

<Layout title={title} description={description}>
  <section class="tool">
    <div class="wrap">
      <header class="tool-header">
        <div class="eyebrow">Teacher tool · Free · No account</div>
        <h1>A brain breaks wheel <em>for when the room needs to move.</em></h1>
        <p class="dek">
          Twelve brain breaks, spun at random. Physical, academic, social, or plain silly — whatever the wheel
          lands on, that's what the room does next. Hit "New 12" to reshuffle when the class has seen this
          batch too many times.
        </p>
      </header>

      <div class="layout">
        <div>
          <div class="wheel-stage">
            <div class="pointer" aria-hidden="true"></div>
            <div class="wheel-shell">
              <svg class="wheel" id="wheel" viewBox="-200 -200 400 400" role="img" aria-label="Brain breaks spinning wheel"></svg>
            </div>
            <div class="hub" id="hub" title="Spin" tabindex="0" role="button" aria-label="Spin the wheel">Spin</div>
          </div>
          <div class="controls">
            <button class="btn" id="spinBtn">Spin the wheel</button>
            <button class="btn ghost" id="resetBtn">New 12</button>
          </div>
          <div class="legend" aria-label="Category legend">
            <span><i style="background:var(--cat-physical)"></i> Physical</span>
            <span><i style="background:var(--cat-academic)"></i> Academic</span>
            <span><i style="background:var(--cat-social)"></i> Social</span>
            <span><i style="background:var(--cat-games)"></i> Games</span>
          </div>
        </div>

        <aside class="result empty" id="result" aria-live="polite">
          <div>Give it a spin. Your brain break will show up here with instructions.</div>
        </aside>
      </div>

      <section class="citation">
        <p>
          The twenty-four brain breaks on this wheel come from
          <a href="https://inclusionrules.com/downloads/" target="_blank" rel="noopener">Inclusion Rules ↗</a>,
          a resource library for inclusive classroom practice. Grab the original guides and downloads there.
        </p>
      </section>
    </div>
  </section>
</Layout>

<style>
  /* Tool-scoped extra tokens. Site-level tokens (--void, --panel, --cyan, etc.)
     already live in global.css. */
  .tool {
    --cat-physical: #22D3EE;   /* cyan — on-brand */
    --cat-academic: #E8B15C;   /* muted amber, tuned to Console */
    --cat-social:   #EC5D9E;   /* warm signal */
    --cat-games:    #7C87C9;   /* cool violet-gray, part of the Console family */
  }

  .wrap {
    max-width: var(--site-max);
    margin: 0 auto;
    padding: 64px var(--edge-pad) 96px;
  }
  @media (max-width: 720px) {
    .wrap { padding: 40px var(--edge-pad) 72px; }
  }

  /* --- Tool page header block (§5.5) --- */
  .tool-header {
    max-width: var(--content-max);
    margin: 0 auto 56px;
  }
  .eyebrow {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-faint);
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 24px;
  }
  .eyebrow::before {
    content: '';
    width: 28px;
    height: 1px;
    background: var(--text-faint);
  }
  h1 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(38px, 5.4vw, 58px);
    letter-spacing: -0.02em;
    line-height: 1.08;
    margin: 0 0 20px;
    color: var(--text);
  }
  h1 em {
    font-style: italic;
    color: var(--cyan);
  }
  .dek {
    font-family: var(--font-serif);
    font-size: 20px;
    line-height: 1.55;
    color: var(--text-dim);
    margin: 0;
  }

  /* --- Tool layout --- */
  .layout {
    display: grid;
    grid-template-columns: minmax(280px, 1fr) minmax(280px, 1fr);
    gap: 48px;
    align-items: start;
  }
  @media (max-width: 860px) {
    .layout { grid-template-columns: 1fr; gap: 40px; }
  }

  .wheel-stage {
    position: relative;
    aspect-ratio: 1 / 1;
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pointer {
    position: absolute;
    top: -6px;
    left: 50%;
    transform: translateX(-50%);
    width: 0; height: 0;
    border-left: 18px solid transparent;
    border-right: 18px solid transparent;
    border-top: 30px solid var(--text);
    filter: drop-shadow(0 4px 10px rgba(0,0,0,0.5));
    z-index: 3;
  }
  .wheel-shell {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    padding: 6px;
    background: var(--line);
    box-shadow:
      0 20px 60px rgba(0,0,0,0.5),
      0 0 0 1px rgba(255,255,255,0.04) inset;
  }
  .wheel {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--void);
    transition: transform 5.6s cubic-bezier(0.14, 0.72, 0.10, 1.00);
    transform: rotate(0deg);
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    .wheel { transition: transform 300ms ease; }
  }
  .hub {
    position: absolute;
    top: 50%; left: 50%;
    width: 78px; height: 78px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--panel);
    border: 1px solid var(--line);
    box-shadow: 0 8px 24px rgba(0,0,0,0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--cyan);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    z-index: 2;
    user-select: none;
    cursor: pointer;
    transition: background 200ms ease, color 200ms ease, border-color 200ms ease;
  }
  .hub:hover { background: var(--cyan); color: var(--void); border-color: var(--cyan); }
  .hub:focus-visible { outline: 2px solid var(--cyan); outline-offset: 3px; }

  .controls {
    display: flex;
    gap: 12px;
    justify-content: center;
    margin-top: 28px;
    flex-wrap: wrap;
  }
  .btn {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.02em;
    padding: 14px 22px;
    border-radius: 4px;
    border: 1px solid var(--cyan);
    color: var(--cyan);
    background: transparent;
    cursor: pointer;
    transition: background 200ms ease, color 200ms ease;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .btn:hover { background: var(--cyan); color: var(--void); }
  .btn:focus-visible { outline: 2px solid var(--cyan); outline-offset: 3px; }
  .btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .btn:disabled:hover { background: transparent; color: var(--cyan); }
  .btn.ghost {
    border-color: var(--line);
    color: var(--text-dim);
  }
  .btn.ghost:hover { background: var(--panel); color: var(--text); border-color: var(--text-faint); }

  .legend {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 24px;
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--text-dim);
  }
  .legend span { display: inline-flex; align-items: center; gap: 8px; }
  .legend i {
    width: 10px; height: 10px; border-radius: 50%;
    display: inline-block;
  }

  /* --- Result panel --- */
  .result {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 32px;
    min-height: 340px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .result.empty {
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--text-faint);
  }
  .result.empty div {
    max-width: 320px;
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.55;
  }
  .result :global(.cat) {
    display: inline-flex;
    align-self: flex-start;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
    padding: 5px 10px;
    border-radius: 3px;
    color: var(--void);
  }
  .result :global(.title) {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(26px, 3.4vw, 34px);
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--text);
  }
  .result :global(.how) {
    font-family: var(--font-serif);
    color: var(--text);
    font-size: 18px;
    line-height: 1.65;
  }
  .result :global(.how strong) {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cyan);
    display: block;
    margin-bottom: 6px;
  }
  .result :global(.cat.physical) { background: var(--cat-physical); }
  .result :global(.cat.academic) { background: var(--cat-academic); }
  .result :global(.cat.social)   { background: var(--cat-social); color: var(--text); }
  .result :global(.cat.games)    { background: var(--cat-games);  color: var(--text); }

  /* --- Citation strip --- */
  .citation {
    max-width: var(--content-max);
    margin: 96px auto 0;
    padding-top: 40px;
    border-top: 1px solid var(--line);
  }
  .citation p {
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.65;
    color: var(--text-dim);
    margin: 0;
  }
  .citation a {
    color: var(--warm);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms ease;
  }
  .citation a:hover { border-bottom-color: var(--warm); }
  .citation a:focus-visible {
    outline: 2px solid var(--warm);
    outline-offset: 3px;
    border-radius: 2px;
  }
</style>

<script is:inline>
  (function () {
    const BREAKS = [
      // Physical Activity & Gross Motor
      { cat: "physical", title: "Dance Party", how: "Play any short, upbeat song and let students move freely — no choreography, just shake it out for 60–90 seconds." },
      { cat: "physical", title: "Structured Dance", how: "Lead the class in a group dance: the chicken dance, the twist, or the hand jive. Everyone follows along." },
      { cat: "physical", title: "Cardio Burst", how: "Do 25 jumping jacks, 25 high knees, or run in place for 30 seconds. Count out loud together." },
      { cat: "physical", title: "Chair Aerobics", how: "Stay seated and do arm punches, seated marches, side reaches, and shoulder rolls. Accessible movement for everyone." },
      { cat: "physical", title: "Yoga Poses & Arm Circles", how: "Try tree pose, mountain pose, or forward fold. Add slow arm circles and deep breathing for grounding." },
      { cat: "physical", title: "Conga Line", how: "Form a line, hands on shoulders, and snake through the classroom doing simple moves — knee lifts, kicks, claps." },

      // Academic & Kinesthetic
      { cat: "academic", title: "Act Out Vocabulary", how: "Pick a current vocab word. Students use their bodies (Total Physical Response) to act out the meaning. No talking." },
      { cat: "academic", title: "Air Writing", how: "Write spelling words, math facts, or draw geometric shapes in the air using big arm movements. Whole-body handwriting." },
      { cat: "academic", title: "Body Spelling", how: "Spell your name or a vocabulary word by making a different body pose for each letter — arms up for A, twist for T, and so on." },
      { cat: "academic", title: "Who Let the Dogs Out", how: "Toss a small plush toy around the room. Whoever catches it names one thing they've learned so far today, then tosses to someone else." },

      // Social & Peer
      { cat: "social", title: "Silent Line-Up", how: "Students line up in order — by birthday, number of siblings, or house number — without talking. Point, gesture, mime only." },
      { cat: "social", title: "Walk & Talk", how: "Grab a partner and take a one-minute walk around the room. Discuss a prompt, or just check in with each other." },
      { cat: "social", title: "Handshake Design", how: "Partner up and design a unique 4-step handshake. Practice it. Be ready to demo to the class." },
      { cat: "social", title: "Charades", how: "Break into small groups. One person acts out a word or phrase silently; the group guesses. No talking from the actor." },
      { cat: "social", title: "Telephone", how: "Sit or stand in a circle. Whisper a short phrase to the person next to you. Pass it around. Compare the start and the end — laugh at the drift." },
      { cat: "social", title: "Rock, Paper, Scissors", how: "Quick partner tournament. Winners find new winners. Last one standing gets bragging rights." },

      // Games & Playful Movement
      { cat: "games", title: "The Wave", how: "Do the wave around the room like a stadium crowd. First at normal speed, then fast, then in slow-motion." },
      { cat: "games", title: "No-Hands Hot Potato", how: "Keep a balloon in the air using only elbows, heads, knees, or shoulders. No hands. Don't let it touch the floor." },
      { cat: "games", title: "Beach Ball Toss", how: "Toss a beach ball around the room. Whoever catches it answers a quick prompt, then passes it on." },
      { cat: "games", title: "Great Wind Blows", how: "Musical-chairs style. Teacher says \"the great wind blows for anyone who…\" (has sneakers, ate cereal, etc.). Anyone it applies to swaps seats." },
      { cat: "games", title: "Room Exploration", how: "Touch all 4 walls of the room and return to your seat as fast — and safely — as possible. Go." },
      { cat: "games", title: "Limbo", how: "Hold a broom or string horizontally. Students take turns going under, leaning back. Lower it each round." },
      { cat: "games", title: "Simon Says", how: "Classic rules. Teacher (or a student) is Simon. Only follow commands prefaced with \"Simon says.\" Out if you slip up." },
      { cat: "games", title: "Four Corners", how: "Label the 4 corners 1–4. Students pick a corner while one player (eyes closed) calls a number. That corner is out. Repeat." }
    ];

    const COLORS = {
      physical: getComputedStyle(document.querySelector('.tool')).getPropertyValue('--cat-physical').trim(),
      academic: getComputedStyle(document.querySelector('.tool')).getPropertyValue('--cat-academic').trim(),
      social:   getComputedStyle(document.querySelector('.tool')).getPropertyValue('--cat-social').trim(),
      games:    getComputedStyle(document.querySelector('.tool')).getPropertyValue('--cat-games').trim()
    };
    const LABEL_INK = {
      physical: "#090C1F",
      academic: "#090C1F",
      social:   "#F1F4FF",
      games:    "#F1F4FF"
    };
    const LABELS = {
      physical: "Physical",
      academic: "Academic",
      social:   "Social",
      games:    "Games"
    };

    const wheel = document.getElementById("wheel");
    const WHEEL_SIZE = 12;
    const R = 190;
    const RLabelInner = 62;

    let ACTIVE = [];
    let pool = [];
    let slice = 360 / WHEEL_SIZE;

    function polar(r, deg) {
      const rad = (deg - 90) * Math.PI / 180;
      return [r * Math.cos(rad), r * Math.sin(rad)];
    }

    function shuffle(arr) {
      const a = arr.slice();
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }

    function drawActive() {
      const needed = WHEEL_SIZE;
      if (pool.length < needed) {
        const tail = pool.slice();
        let fresh = shuffle(BREAKS);
        if (tail.length) {
          const tailTitles = new Set(tail.map(b => b.title));
          fresh.sort((a, b) => {
            const aTail = tailTitles.has(a.title) ? 1 : 0;
            const bTail = tailTitles.has(b.title) ? 1 : 0;
            return aTail - bTail;
          });
        }
        pool = tail.concat(fresh);
      }
      ACTIVE = pool.slice(0, needed);
      pool = pool.slice(needed);
    }

    function makeSlice(i) {
      const a0 = i * slice;
      const a1 = (i + 1) * slice;
      const [x0, y0] = polar(R, a0);
      const [x1, y1] = polar(R, a1);
      const large = slice > 180 ? 1 : 0;
      const d = `M 0 0 L ${x0.toFixed(3)} ${y0.toFixed(3)} A ${R} ${R} 0 ${large} 1 ${x1.toFixed(3)} ${y1.toFixed(3)} Z`;
      const color = COLORS[ACTIVE[i].cat];
      const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
      path.setAttribute("d", d);
      path.setAttribute("fill", color);
      path.setAttribute("stroke", "#090C1F");
      path.setAttribute("stroke-width", "1.5");
      return path;
    }

    function makeLabel(i) {
      const mid = i * slice + slice / 2;
      const g = document.createElementNS("http://www.w3.org/2000/svg", "g");

      const text = document.createElementNS("http://www.w3.org/2000/svg", "text");
      text.setAttribute("fill", LABEL_INK[ACTIVE[i].cat]);
      text.setAttribute("font-family", "Inter, ui-sans-serif, system-ui, sans-serif");
      text.setAttribute("font-weight", "600");
      text.setAttribute("font-size", "14");
      text.setAttribute("letter-spacing", "0.01em");
      text.setAttribute("dominant-baseline", "middle");

      let t = ACTIVE[i].title;
      const maxChars = 20;
      if (t.length > maxChars) t = t.slice(0, maxChars - 1) + "…";
      text.textContent = t;

      const rightSide = mid < 180;
      if (rightSide) {
        g.setAttribute("transform", `rotate(${mid - 90})`);
        text.setAttribute("text-anchor", "start");
        text.setAttribute("x", RLabelInner.toString());
        text.setAttribute("y", "0");
      } else {
        g.setAttribute("transform", `rotate(${mid + 90})`);
        text.setAttribute("text-anchor", "end");
        text.setAttribute("x", (-RLabelInner).toString());
        text.setAttribute("y", "0");
      }

      g.appendChild(text);
      return g;
    }

    function renderWheel() {
      while (wheel.firstChild) wheel.removeChild(wheel.firstChild);
      for (let i = 0; i < WHEEL_SIZE; i++) wheel.appendChild(makeSlice(i));
      for (let i = 0; i < WHEEL_SIZE; i++) wheel.appendChild(makeLabel(i));
      const inner = document.createElementNS("http://www.w3.org/2000/svg", "circle");
      inner.setAttribute("r", "40");
      inner.setAttribute("fill", "#090C1F");
      inner.setAttribute("stroke", "#232852");
      inner.setAttribute("stroke-width", "1.5");
      wheel.appendChild(inner);
    }

    drawActive();
    renderWheel();

    const spinBtn = document.getElementById("spinBtn");
    const resetBtn = document.getElementById("resetBtn");
    const hub = document.getElementById("hub");
    const resultEl = document.getElementById("result");

    let currentRotation = 0;
    let spinning = false;

    function spin() {
      if (spinning) return;
      spinning = true;
      spinBtn.disabled = true;

      const idx = Math.floor(Math.random() * WHEEL_SIZE);
      const target = 360 - (idx * slice + slice / 2);
      const spins = 6;
      const currentMod = ((currentRotation % 360) + 360) % 360;
      const delta = ((target - currentMod) + 360) % 360;
      const nextRotation = currentRotation + spins * 360 + delta;
      currentRotation = nextRotation;
      wheel.style.transform = `rotate(${nextRotation}deg)`;

      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const wait = prefersReduced ? 320 : 5700;
      setTimeout(() => {
        showResult(ACTIVE[idx]);
        spinning = false;
        spinBtn.disabled = false;
      }, wait);
    }

    function reshuffleWheel() {
      if (spinning) return;
      drawActive();
      const prevTransition = wheel.style.transition;
      wheel.style.transition = "none";
      currentRotation = 0;
      wheel.style.transform = "rotate(0deg)";
      void wheel.getBoundingClientRect();
      renderWheel();
      wheel.style.transition = prevTransition;
      reset();
    }

    function showResult(b) {
      resultEl.classList.remove("empty");
      resultEl.innerHTML = `
        <span class="cat ${b.cat}">${LABELS[b.cat]}</span>
        <div class="title">${b.title}</div>
        <div class="how"><strong>How to do it</strong>${b.how}</div>
      `;
    }

    function reset() {
      resultEl.classList.add("empty");
      resultEl.innerHTML = `<div>Give it a spin. Your brain break will show up here with instructions.</div>`;
    }

    spinBtn.addEventListener("click", spin);
    hub.addEventListener("click", spin);
    hub.addEventListener("keydown", (e) => {
      if (e.code === "Space" || e.code === "Enter") { e.preventDefault(); spin(); }
    });
    resetBtn.addEventListener("click", reshuffleWheel);
  })();
</script>
</Layout>
