${CLOSE_STYLE}
</head>
<body>
<div class="app">
  <header class="gameHeader">
    <h1 class="gameTitle" id="gameTitleEl"></h1>
    <div class="headerActions">
      <button class="headBtn" id="soundBtn" type="button" aria-pressed="true">Sound: On</button>
      <button class="headBtn" id="fsBtn" type="button">Full screen</button>
      <button class="headBtn" id="resetBtn" type="button">Reset scores</button>
    </div>
  </header>

  <main class="boardMain">
    <div class="board" id="boardEl" role="grid" aria-label="Jeopardy game board"></div>
  </main>

  <div class="clueBackdrop" id="clueBackdrop" hidden>
    <div class="cluePanel" id="cluePanel" role="dialog" aria-modal="true" aria-labelledby="clueText">
      <div class="clueKicker" id="clueKicker"></div>
      <p class="clueText" id="clueText"></p>
      <p class="clueAnswer hidden" id="clueAnswer"></p>
      <div class="clueActions">
        <button class="clueBtn ghost" id="clueCloseBtn" type="button">Close</button>
        <button class="clueBtn" id="revealBtn" type="button">Reveal answer</button>
      </div>
    </div>
  </div>

  <div class="scoreboard" id="scoreboardEl" aria-label="Team scoreboard"></div>

  <div class="footStrip">Built with the Jeopardy Game Creator · austinmcnair.com</div>
</div>

${OPEN_SCRIPT}
  (function () {
    'use strict';
    const DATA = ${dataJson};

    const gameTitleEl = document.getElementById('gameTitleEl');
    gameTitleEl.textContent = DATA.title || 'Classroom Jeopardy';
    document.title = DATA.title || 'Classroom Jeopardy';

    // -------- audio --------
    let audioCtx = null;
    let soundOn = true;
    function ensureCtx() {
      if (!audioCtx) {
        try {
          const AC = window.AudioContext || window.webkitAudioContext;
          if (AC) audioCtx = new AC();
        } catch (e) { audioCtx = null; }
      }
      return audioCtx;
    }
    function tone(freq, duration, opts) {
      if (!soundOn) return;
      const ctx = ensureCtx();
      if (!ctx) return;
      const o = ctx.createOscillator();
      const g = ctx.createGain();
      o.type = (opts && opts.type) || 'sine';
      o.frequency.setValueAtTime(freq, ctx.currentTime);
      const peak = (opts && opts.gain) || 0.18;
      g.gain.setValueAtTime(0.0001, ctx.currentTime);
      g.gain.exponentialRampToValueAtTime(peak, ctx.currentTime + 0.02);
      g.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + duration);
      o.connect(g).connect(ctx.destination);
      o.start();
      o.stop(ctx.currentTime + duration + 0.05);
    }
    function playSelect() { tone(520, 0.14, { type: 'sine' }); }
    function playReveal() { tone(660, 0.18, { type: 'triangle' }); setTimeout(() => tone(880, 0.24, { type: 'triangle' }), 120); }
    function playDailyDouble() {
      const seq = [523, 659, 784, 1047];
      seq.forEach((f, i) => setTimeout(() => tone(f, 0.22, { type: 'triangle', gain: 0.22 }), i * 140));
    }

    const soundBtn = document.getElementById('soundBtn');
    soundBtn.addEventListener('click', () => {
      soundOn = !soundOn;
      soundBtn.textContent = soundOn ? 'Sound: On' : 'Sound: Off';
      soundBtn.setAttribute('aria-pressed', soundOn ? 'true' : 'false');
    });

    // -------- fullscreen --------
    document.getElementById('fsBtn').addEventListener('click', () => {
      const el = document.documentElement;
      if (!document.fullscreenElement && el.requestFullscreen) {
        el.requestFullscreen().catch(() => {});
      } else if (document.exitFullscreen) {
        document.exitFullscreen().catch(() => {});
      }
    });

    // -------- board --------
    const boardEl = document.getElementById('boardEl');
    const used = new Set(); // "c-q"
    function key(c, q) { return c + '-' + q; }

    function renderBoard() {
      boardEl.innerHTML = '';
      const cats = DATA.categories || [];
      for (let c = 0; c < 5; c++) {
        const head = document.createElement('div');
        head.className = 'catHead';
        head.textContent = (cats[c] && cats[c].name) || ('Category ' + (c + 1));
        boardEl.appendChild(head);
      }
      const points = [200, 400, 600, 800, 1000];
      for (let q = 0; q < 5; q++) {
        for (let c = 0; c < 5; c++) {
          const cell = document.createElement('button');
          cell.type = 'button';
          cell.className = 'cell';
          cell.setAttribute('role', 'gridcell');
          const cat = cats[c] || {};
          const item = (cat.questions && cat.questions[q]) || null;
          const p = (item && item.points) || points[q];
          cell.textContent = '$' + p;
          if (used.has(key(c, q)) || !item || !item.question) {
            // Empty cells go straight to used-state so play doesn't dead-end.
            if (!item || !item.question) {
              cell.classList.add('used');
              cell.setAttribute('aria-label', '$' + p + ' — empty');
              cell.tabIndex = -1;
            }
          }
          if (used.has(key(c, q))) {
            cell.classList.add('used');
            cell.tabIndex = -1;
          }
          if (item && item.question) {
            cell.setAttribute('aria-label', ((cat.name) || 'Category ' + (c + 1)) + ', $' + p + (item.isDailyDouble ? ', Daily Double' : ''));
            cell.addEventListener('click', () => openClue(c, q));
          }
          boardEl.appendChild(cell);
        }
      }
    }

    // -------- clue modal --------
    const clueBackdrop = document.getElementById('clueBackdrop');
    const cluePanel = document.getElementById('cluePanel');
    const clueKicker = document.getElementById('clueKicker');
    const clueText = document.getElementById('clueText');
    const clueAnswer = document.getElementById('clueAnswer');
    const revealBtn = document.getElementById('revealBtn');
    const clueCloseBtn = document.getElementById('clueCloseBtn');
    let currentPos = null;

    function openClue(c, q) {
      const cat = (DATA.categories && DATA.categories[c]) || {};
      const item = (cat.questions && cat.questions[q]) || null;
      if (!item || !item.question) return;
      currentPos = { c, q };
      const catName = cat.name || ('Category ' + (c + 1));
      const isDD = !!item.isDailyDouble;
      clueKicker.textContent = isDD ? 'Daily Double · ' + catName : catName + ' · $' + item.points;
      clueKicker.className = 'clueKicker' + (isDD ? ' dd' : '');
      cluePanel.className = 'cluePanel' + (isDD ? ' dd' : '');
      clueText.textContent = item.question;
      clueAnswer.textContent = item.answer || '';
      clueAnswer.classList.add('hidden');
      revealBtn.textContent = 'Reveal answer';
      revealBtn.dataset.state = 'clue';
      clueBackdrop.hidden = false;
      if (isDD) playDailyDouble(); else playSelect();
      setTimeout(() => revealBtn.focus(), 20);
    }
    function closeClue() {
      if (currentPos) {
        used.add(key(currentPos.c, currentPos.q));
        currentPos = null;
      }
      clueBackdrop.hidden = true;
      renderBoard();
    }
    revealBtn.addEventListener('click', () => {
      if (revealBtn.dataset.state === 'clue') {
        clueAnswer.classList.remove('hidden');
        revealBtn.textContent = 'Mark used & close';
        revealBtn.dataset.state = 'reveal';
        playReveal();
      } else {
        closeClue();
      }
    });
    clueCloseBtn.addEventListener('click', () => {
      // Close without marking the cell used (accidental clicks).
      currentPos = null;
      clueBackdrop.hidden = true;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !clueBackdrop.hidden) {
        currentPos = null;
        clueBackdrop.hidden = true;
      }
      if (e.key === ' ' && !clueBackdrop.hidden) {
        e.preventDefault();
        revealBtn.click();
      }
    });

    // -------- scoreboard --------
    const scoreboardEl = document.getElementById('scoreboardEl');
    let teams = [
      { name: 'Team 1', score: 0 },
      { name: 'Team 2', score: 0 },
      { name: 'Team 3', score: 0 },
    ];
    function renderScoreboard() {
      scoreboardEl.innerHTML = '';
      teams.forEach((t, i) => {
        const team = document.createElement('div');
        team.className = 'team';
        const nameInput = document.createElement('input');
        nameInput.type = 'text';
        nameInput.className = 'teamName';
        nameInput.value = t.name;
        nameInput.setAttribute('aria-label', 'Team ' + (i + 1) + ' name');
        nameInput.addEventListener('input', (e) => { teams[i].name = e.target.value; });

        const row = document.createElement('div');
        row.className = 'teamScoreRow';
        const minus100 = document.createElement('button');
        minus100.className = 'scoreBtn';
        minus100.type = 'button';
        minus100.textContent = '−';
        minus100.setAttribute('aria-label', 'Subtract 100 from ' + t.name);
        minus100.addEventListener('click', () => { teams[i].score -= 100; renderScoreboard(); });

        const scoreEl = document.createElement('div');
        scoreEl.className = 'teamScore' + (t.score < 0 ? ' neg' : '');
        scoreEl.textContent = (t.score < 0 ? '−$' : '$') + Math.abs(t.score);

        const plus100 = document.createElement('button');
        plus100.className = 'scoreBtn';
        plus100.type = 'button';
        plus100.textContent = '+';
        plus100.setAttribute('aria-label', 'Add 100 to ' + t.name);
        plus100.addEventListener('click', () => { teams[i].score += 100; renderScoreboard(); });

        row.appendChild(minus100);
        row.appendChild(scoreEl);
        row.appendChild(plus100);
        team.appendChild(nameInput);
        team.appendChild(row);
        scoreboardEl.appendChild(team);
      });
    }
    document.getElementById('resetBtn').addEventListener('click', () => {
      if (!confirm('Reset all team scores to 0?')) return;
      teams = teams.map((t) => ({ name: t.name, score: 0 }));
      used.clear();
      renderScoreboard();
      renderBoard();
    });

    renderBoard();
    renderScoreboard();
  })();
${CLOSE_SCRIPT}
</body>
</html>`;
    }

    // Basic HTML escape for values injected into the exported document's markup.
    // The main data payload is JSON-serialized (with a script-tag-safe swap),
    // so this only matters for the outer document title.
    // (Historically a bare closing script tag in this comment would terminate
    // the surrounding inline script early. Fixed by not writing it.)
    function escapeHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    // =============================================================================
    // Bootstrap
    // =============================================================================
    load();
    render();
  })();
</script>
</Layout>
