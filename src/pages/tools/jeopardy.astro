---
import Layout from '../../layouts/Layout.astro';

const title = 'Jeopardy Game Creator — Austin McNair';
const description =
  'A free, browser-based Jeopardy game builder for K–12 teachers. No login. No accounts. Build a 25-question review board and download a single .html file that runs on any classroom projector offline.';
---

<Layout title={title} description={description}>
  <section class="tool">
    <div class="wrap">
      <header class="tool-header">
        <div class="eyebrow">Teacher tool · Free · No account</div>
        <h1>A Jeopardy builder <em>for your classroom.</em></h1>
        <p class="dek">
          Type in your clues, click Download, and walk away with a single <code>.html</code> file that runs on
          any classroom projector without internet. Five categories, twenty-five questions, one Daily Double.
          Nothing to install. Nothing to sign up for.
        </p>
      </header>

      <div class="controlbar">
        <label class="titleField">
          <span class="titleFieldLabel">Game title</span>
          <input
            id="gameTitleInput"
            type="text"
            placeholder="Untitled Jeopardy game"
            autocomplete="off"
            spellcheck="true"
          />
        </label>
        <div class="progress" aria-live="polite">
          <span class="progressCount" id="progressCount">0 / 25</span>
          <span class="progressLabel">questions filled</span>
        </div>
        <div class="controlbarBtns">
          <button class="btn ghost" id="importBtn" type="button">Import JSON</button>
          <button class="btn ghost" id="exportJsonBtn" type="button">Copy JSON</button>
          <button class="btn ghost danger" id="clearBtn" type="button">Clear board</button>
        </div>
      </div>

      <div class="boardWrap">
        <div
          class="board"
          id="board"
          role="grid"
          aria-label="Jeopardy game board, 5 categories by 5 point levels"
        ></div>
      </div>

      <section class="artifact" aria-labelledby="artifactLabel">
        <div class="artifactLabel" id="artifactLabel">Artifact</div>
        <h2 class="artifactTitle">Download your game</h2>
        <p class="artifactCopy">
          One <code>.html</code> file. Runs offline on any classroom projector — no internet, no accounts, no
          ads. Save it to a USB stick or drop it on your desktop.
        </p>
        <button class="btn warm" id="downloadBtn" type="button">
          Download game <span class="arrow" aria-hidden="true">↗</span>
        </button>
      </section>

    </div>
  </section>

  <!-- ============ Q&A modal ============ -->
  <div class="modalBackdrop" id="modalBackdrop" hidden>
    <div
      class="modal"
      id="modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modalTitle"
    >
      <div class="modalHead">
        <div>
          <div class="modalKicker" id="modalKicker">Category · $200</div>
          <h3 class="modalTitle" id="modalTitle">Edit clue</h3>
        </div>
        <button class="iconBtn" id="modalCloseBtn" type="button" aria-label="Close without saving">✕</button>
      </div>
      <div class="modalBody">
        <label class="field">
          <span class="fieldLabel">Clue</span>
          <textarea
            id="clueInput"
            rows="3"
            placeholder="This organelle is often called the powerhouse of the cell."
            spellcheck="true"
          ></textarea>
        </label>
        <label class="field">
          <span class="fieldLabel">Answer</span>
          <textarea
            id="answerInput"
            rows="2"
            placeholder="What is the Mitochondria?"
            spellcheck="true"
          ></textarea>
        </label>
        <label class="ddToggle">
          <input type="checkbox" id="ddInput" />
          <span class="ddToggleUi" aria-hidden="true"></span>
          <span class="ddToggleLabel">Mark as Daily Double</span>
        </label>
        <p class="ddNote" id="ddNote">Only one clue per board can be the Daily Double.</p>
      </div>
      <div class="modalFoot">
        <button class="btn ghost" id="modalCancelBtn" type="button">Cancel</button>
        <button class="btn ghost" id="modalSaveNextBtn" type="button">Save &amp; Next</button>
        <button class="btn" id="modalSaveBtn" type="button">Save</button>
      </div>
    </div>
  </div>

  <!-- ============ Import JSON modal ============ -->
  <div class="modalBackdrop" id="importBackdrop" hidden>
    <div
      class="modal wide"
      role="dialog"
      aria-modal="true"
      aria-labelledby="importTitle"
    >
      <div class="modalHead">
        <div>
          <div class="modalKicker">Import</div>
          <h3 class="modalTitle" id="importTitle">Paste a game file (JSON)</h3>
        </div>
        <button class="iconBtn" id="importCloseBtn" type="button" aria-label="Close">✕</button>
      </div>
      <div class="modalBody">
        <textarea
          id="importArea"
          rows="14"
          spellcheck="false"
          placeholder='{ "title": "…", "categories": [ … ] }'
        ></textarea>
        <p class="ddNote" id="importNote">Paste a JSON export from this tool. Import replaces the current board.</p>
      </div>
      <div class="modalFoot">
        <button class="btn ghost" id="importCancelBtn" type="button">Cancel</button>
        <button class="btn" id="importConfirmBtn" type="button">Replace board</button>
      </div>
    </div>
  </div>

  <!-- toast -->
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
</Layout>

<style>
  /* ================= tokens ================= */
  .tool {
    --cell-radius: 6px;
    --focus: 2px solid var(--cyan);
  }

  .wrap {
    max-width: var(--site-max);
    margin: 0 auto;
    padding: 64px var(--edge-pad) 96px;
  }
  @media (max-width: 720px) {
    .wrap { padding: 40px var(--edge-pad) 72px; }
  }

  /* ================= header block (§5.5) ================= */
  .tool-header {
    max-width: var(--content-max);
    margin: 0 auto 56px;
  }
  .eyebrow {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-faint);
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 24px;
  }
  .eyebrow::before {
    content: '';
    width: 28px; height: 1px;
    background: var(--text-faint);
  }
  h1 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(38px, 5.4vw, 58px);
    letter-spacing: -0.02em;
    line-height: 1.08;
    margin: 0 0 20px;
    color: var(--text);
  }
  h1 em {
    font-style: italic;
    color: var(--cyan);
  }
  .dek {
    font-family: var(--font-serif);
    font-size: 20px;
    line-height: 1.55;
    color: var(--text-dim);
    margin: 0;
  }
  .dek code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9em;
    background: var(--panel);
    padding: 1px 6px;
    border-radius: 3px;
    color: var(--cyan);
  }

  /* ================= controlbar ================= */
  .controlbar {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: end;
    gap: 24px;
    padding: 20px 24px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    margin-bottom: 32px;
  }
  @media (max-width: 900px) {
    .controlbar { grid-template-columns: 1fr; align-items: stretch; gap: 16px; }
  }
  .titleField {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .titleFieldLabel {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .titleField input {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 500;
    color: var(--text);
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--line);
    padding: 6px 0;
    outline: none;
    transition: border-color 200ms ease;
  }
  .titleField input:focus { border-bottom-color: var(--cyan); }
  .titleField input::placeholder { color: var(--text-faint); font-style: italic; }

  .progress {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    white-space: nowrap;
  }
  .progressCount {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 24px;
    letter-spacing: 0.04em;
    color: var(--cyan);
    line-height: 1;
  }
  .progressLabel {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .controlbarBtns {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  /* ================= buttons ================= */
  .btn {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.02em;
    padding: 12px 20px;
    border-radius: 4px;
    border: 1px solid var(--cyan);
    color: var(--cyan);
    background: transparent;
    cursor: pointer;
    transition: background 200ms ease, color 200ms ease, border-color 200ms ease;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }
  .btn:hover { background: var(--cyan); color: var(--void); }
  .btn:focus-visible { outline: var(--focus); outline-offset: 3px; }
  .btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .btn:disabled:hover { background: transparent; color: var(--cyan); }
  .btn.ghost {
    border-color: var(--line);
    color: var(--text-dim);
    font-size: 13px;
    padding: 10px 16px;
  }
  .btn.ghost:hover { background: var(--panel); color: var(--text); border-color: var(--text-faint); }
  .btn.ghost.danger { color: #ffb0b0; }
  .btn.ghost.danger:hover { border-color: var(--warn); color: var(--warn); background: transparent; }
  .btn.warm {
    border-color: var(--warm);
    color: var(--warm);
  }
  .btn.warm:hover { background: var(--warm); color: var(--void); }
  .btn.warm:focus-visible { outline: 2px solid var(--warm); outline-offset: 3px; }
  .btn.warm .arrow { transition: transform 200ms ease; }
  .btn.warm:hover .arrow { transform: translate(2px, -2px); }

  .iconBtn {
    appearance: none;
    background: transparent;
    border: 1px solid var(--line);
    color: var(--text-dim);
    width: 36px;
    height: 36px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 200ms ease, color 200ms ease, border-color 200ms ease;
  }
  .iconBtn:hover { color: var(--text); border-color: var(--text-faint); }
  .iconBtn:focus-visible { outline: var(--focus); outline-offset: 3px; }

  /* ================= board ================= */
  .boardWrap {
    margin-bottom: 48px;
    overflow-x: auto;
  }
  .board {
    display: grid;
    grid-template-columns: repeat(5, minmax(140px, 1fr));
    gap: 10px;
    min-width: 780px;
  }
  .catHeader {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--cell-radius);
    padding: 14px 12px;
  }
  .catHeader input {
    width: 100%;
    background: transparent;
    border: none;
    outline: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text);
    text-align: center;
    padding: 4px 0;
    border-bottom: 1px solid transparent;
    transition: border-color 200ms ease;
  }
  .catHeader input:focus { border-bottom-color: var(--cyan); }
  .catHeader input::placeholder { color: var(--text-faint); font-weight: 500; }

  .cell {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--cell-radius);
    padding: 14px 12px;
    min-height: 120px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-align: left;
    color: var(--text);
    font-family: inherit;
    transition: border-color 200ms ease, transform 200ms ease, background 200ms ease;
    position: relative;
  }
  .cell:hover {
    border-color: var(--cyan);
    transform: translateY(-1px);
    background: rgba(34, 211, 238, 0.04);
  }
  .cell:focus-visible {
    outline: var(--focus);
    outline-offset: 3px;
  }
  .cellTop {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }
  .cellPoints {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 0.02em;
    color: var(--cyan);
    line-height: 1;
  }
  .cellBadges {
    display: flex;
    gap: 6px;
    align-items: center;
  }
  .cellDD {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--void);
    background: var(--warm);
    padding: 2px 6px;
    border-radius: 3px;
  }
  .cellStatus {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--line);
    display: inline-block;
  }
  .cell.filled .cellStatus { background: var(--ok); }
  .cellPreview {
    font-family: var(--font-serif);
    font-size: 14px;
    line-height: 1.4;
    color: var(--text-dim);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .cellPreviewEmpty {
    color: var(--text-faint);
    font-style: italic;
  }

  /* ================= artifact block (§5.5 + §7.6 warm) ================= */
  .artifact {
    background: var(--panel);
    border: 1px solid var(--line);
    border-left: 3px solid var(--warm);
    border-radius: 4px;
    padding: 28px 32px;
    margin-bottom: 64px;
    max-width: var(--content-max);
  }
  .artifactLabel {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--warm);
    margin-bottom: 8px;
  }
  .artifactTitle {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(24px, 3vw, 30px);
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--text);
    margin: 0 0 8px;
  }
  .artifactCopy {
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-dim);
    margin: 0 0 20px;
  }
  .artifactCopy code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9em;
    background: rgba(236, 93, 158, 0.08);
    padding: 1px 6px;
    border-radius: 3px;
    color: var(--warm);
  }

  /* ================= modal ================= */
  .modalBackdrop {
    position: fixed;
    inset: 0;
    background: rgba(9, 12, 31, 0.82);
    backdrop-filter: blur(4px);
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .modalBackdrop[hidden] { display: none; }
  .modal {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    width: 100%;
    max-width: 560px;
    max-height: 90vh;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    box-shadow: 0 40px 100px rgba(0,0,0,0.6);
  }
  .modal.wide { max-width: 720px; }
  .modalHead {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    padding: 24px 24px 12px;
    border-bottom: 1px solid var(--line);
  }
  .modalKicker {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cyan);
    margin-bottom: 4px;
  }
  .modalTitle {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 22px;
    letter-spacing: -0.01em;
    color: var(--text);
    margin: 0;
  }
  .modalBody {
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .modalFoot {
    padding: 16px 24px 20px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    flex-wrap: wrap;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .fieldLabel {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .field textarea,
  .modalBody textarea {
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.5;
    color: var(--text);
    background: var(--void);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 12px 14px;
    resize: vertical;
    outline: none;
    transition: border-color 200ms ease;
  }
  .field textarea:focus,
  .modalBody textarea:focus { border-color: var(--cyan); }
  #importArea {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 13px;
    line-height: 1.5;
  }

  .ddToggle {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    user-select: none;
    padding: 4px 0;
  }
  .ddToggle input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .ddToggleUi {
    width: 36px;
    height: 20px;
    background: var(--line);
    border-radius: 999px;
    position: relative;
    transition: background 200ms ease;
    flex: 0 0 auto;
  }
  .ddToggleUi::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--text);
    transition: transform 200ms ease;
  }
  .ddToggle input:checked + .ddToggleUi { background: var(--warm); }
  .ddToggle input:checked + .ddToggleUi::after { transform: translateX(16px); }
  .ddToggle input:focus-visible + .ddToggleUi {
    outline: 2px solid var(--cyan);
    outline-offset: 3px;
  }
  .ddToggleLabel {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text);
  }
  .ddNote {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--text-faint);
    margin: 0;
  }

  /* ================= toast ================= */
  .toast {
    position: fixed;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%) translateY(20px);
    background: var(--panel);
    border: 1px solid var(--line);
    border-left: 3px solid var(--cyan);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 14px;
    padding: 12px 20px;
    border-radius: 4px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    opacity: 0;
    pointer-events: none;
    transition: transform 220ms ease, opacity 220ms ease;
    z-index: 60;
    max-width: 90vw;
  }
  .toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  .toast.error { border-left-color: var(--warn); }

  /* ================= reduced motion ================= */
  @media (prefers-reduced-motion: reduce) {
    .cell,
    .btn,
    .btn.warm .arrow,
    .ddToggleUi,
    .ddToggleUi::after,
    .toast { transition: none; }
    .cell:hover { transform: none; }
  }
</style>

<script is:inline>
  (function () {
    'use strict';

    // =============================================================================
    // Constants
    // =============================================================================
    const STORAGE_KEY = 'mcnair_jeopardy_creator_state';
    const POINT_LEVELS = [200, 400, 600, 800, 1000];
    const CATEGORY_COUNT = 5;

    // =============================================================================
    // State
    // =============================================================================
    function makeBlankState() {
      const categories = [];
      for (let c = 0; c < CATEGORY_COUNT; c++) {
        const questions = POINT_LEVELS.map((points) => ({
          points,
          question: '',
          answer: '',
          isDailyDouble: false,
        }));
        categories.push({ name: '', questions });
      }
      return { title: '', categories };
    }

    let state = makeBlankState();
    let currentCell = null; // { cIdx, qIdx } when the modal is open

    // =============================================================================
    // Persistence
    // =============================================================================
    function save() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      } catch (err) {
        // Quota / private-mode failure. Non-fatal.
        console.warn('Autosave failed', err);
      }
    }

    function load() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return;
        const parsed = JSON.parse(raw);
        if (validateState(parsed)) {
          state = normalizeState(parsed);
        }
      } catch (err) {
        console.warn('Load failed', err);
      }
    }

    function validateState(candidate) {
      if (!candidate || typeof candidate !== 'object') return false;
      if (typeof candidate.title !== 'string') return false;
      if (!Array.isArray(candidate.categories)) return false;
      return true;
    }

    // Coerce any imported / stored state into a valid 5x5 shape so a partial
    // import can never crash render.
    function normalizeState(input) {
      const out = makeBlankState();
      out.title = typeof input.title === 'string' ? input.title : '';
      const cats = Array.isArray(input.categories) ? input.categories : [];
      for (let c = 0; c < CATEGORY_COUNT; c++) {
        const srcCat = cats[c] || {};
        out.categories[c].name = typeof srcCat.name === 'string' ? srcCat.name : '';
        const srcQs = Array.isArray(srcCat.questions) ? srcCat.questions : [];
        for (let q = 0; q < POINT_LEVELS.length; q++) {
          const srcQ = srcQs.find((x) => x && x.points === POINT_LEVELS[q]) || srcQs[q] || {};
          out.categories[c].questions[q] = {
            points: POINT_LEVELS[q],
            question: typeof srcQ.question === 'string' ? srcQ.question : '',
            answer: typeof srcQ.answer === 'string' ? srcQ.answer : '',
            isDailyDouble: srcQ.isDailyDouble === true,
          };
        }
      }
      // Enforce single Daily Double.
      let ddCount = 0;
      for (const cat of out.categories) {
        for (const q of cat.questions) {
          if (q.isDailyDouble) {
            ddCount++;
            if (ddCount > 1) q.isDailyDouble = false;
          }
        }
      }
      return out;
    }

    // =============================================================================
    // Rendering
    // =============================================================================
    const boardEl = document.getElementById('board');
    const titleInputEl = document.getElementById('gameTitleInput');
    const progressEl = document.getElementById('progressCount');

    function render() {
      titleInputEl.value = state.title;
      renderBoard();
      renderProgress();
    }

    function renderBoard() {
      boardEl.innerHTML = '';

      // Category headers row.
      for (let c = 0; c < CATEGORY_COUNT; c++) {
        const header = document.createElement('div');
        header.className = 'catHeader';
        header.setAttribute('role', 'columnheader');
        const input = document.createElement('input');
        input.type = 'text';
        input.value = state.categories[c].name;
        input.placeholder = `Category ${c + 1}`;
        input.setAttribute('aria-label', `Category ${c + 1} name`);
        input.addEventListener('input', (e) => {
          state.categories[c].name = e.target.value;
          save();
        });
        header.appendChild(input);
        boardEl.appendChild(header);
      }

      // Cells row by row so keyboard tab order reads left-to-right, top-to-bottom.
      for (let q = 0; q < POINT_LEVELS.length; q++) {
        for (let c = 0; c < CATEGORY_COUNT; c++) {
          const cell = renderCell(c, q);
          boardEl.appendChild(cell);
        }
      }
    }

    function renderCell(cIdx, qIdx) {
      const data = state.categories[cIdx].questions[qIdx];
      const cell = document.createElement('button');
      cell.type = 'button';
      cell.className = 'cell';
      cell.setAttribute('role', 'gridcell');
      cell.setAttribute('data-c', String(cIdx));
      cell.setAttribute('data-q', String(qIdx));
      const filled = isFilled(data);
      if (filled) cell.classList.add('filled');
      const catLabel = state.categories[cIdx].name || `Category ${cIdx + 1}`;
      cell.setAttribute(
        'aria-label',
        `${catLabel}, $${data.points}, ${filled ? 'filled' : 'empty'}${data.isDailyDouble ? ', Daily Double' : ''}`
      );

      const top = document.createElement('div');
      top.className = 'cellTop';
      const points = document.createElement('span');
      points.className = 'cellPoints';
      points.textContent = '$' + data.points;
      top.appendChild(points);

      const badges = document.createElement('div');
      badges.className = 'cellBadges';
      if (data.isDailyDouble) {
        const dd = document.createElement('span');
        dd.className = 'cellDD';
        dd.textContent = 'DD';
        dd.setAttribute('aria-hidden', 'true');
        badges.appendChild(dd);
      }
      const status = document.createElement('span');
      status.className = 'cellStatus';
      status.setAttribute('aria-hidden', 'true');
      badges.appendChild(status);
      top.appendChild(badges);

      cell.appendChild(top);

      const preview = document.createElement('div');
      preview.className = 'cellPreview' + (filled ? '' : ' cellPreviewEmpty');
      preview.textContent = filled ? truncate(data.question, 90) : 'Click to add a clue';
      cell.appendChild(preview);

      cell.addEventListener('click', () => openModal(cIdx, qIdx));
      return cell;
    }

    function renderProgress() {
      const total = CATEGORY_COUNT * POINT_LEVELS.length;
      let filled = 0;
      for (const cat of state.categories) {
        for (const q of cat.questions) {
          if (isFilled(q)) filled++;
        }
      }
      progressEl.textContent = filled + ' / ' + total;
    }

    function isFilled(q) {
      return !!(q && q.question && q.question.trim() && q.answer && q.answer.trim());
    }

    function truncate(str, n) {
      if (!str) return '';
      const s = str.trim();
      return s.length > n ? s.slice(0, n - 1) + '…' : s;
    }

    // =============================================================================
    // Q&A modal
    // =============================================================================
    const modalBackdrop = document.getElementById('modalBackdrop');
    const modalKicker = document.getElementById('modalKicker');
    const clueInput = document.getElementById('clueInput');
    const answerInput = document.getElementById('answerInput');
    const ddInput = document.getElementById('ddInput');
    const modalCloseBtn = document.getElementById('modalCloseBtn');
    const modalCancelBtn = document.getElementById('modalCancelBtn');
    const modalSaveBtn = document.getElementById('modalSaveBtn');
    const modalSaveNextBtn = document.getElementById('modalSaveNextBtn');
    let lastFocusBeforeModal = null;

    function openModal(cIdx, qIdx) {
      currentCell = { cIdx, qIdx };
      const cat = state.categories[cIdx];
      const q = cat.questions[qIdx];
      const catName = cat.name || `Category ${cIdx + 1}`;
      modalKicker.textContent = `${catName} · $${q.points}`;
      clueInput.value = q.question;
      answerInput.value = q.answer;
      ddInput.checked = q.isDailyDouble;
      lastFocusBeforeModal = document.activeElement;
      modalBackdrop.hidden = false;
      // Focus the clue field; small delay so browsers don't skip focus on newly
      // unhidden element.
      setTimeout(() => clueInput.focus(), 20);
    }

    function closeModal() {
      modalBackdrop.hidden = true;
      currentCell = null;
      if (lastFocusBeforeModal && typeof lastFocusBeforeModal.focus === 'function') {
        lastFocusBeforeModal.focus();
      }
    }

    function saveModal() {
      if (!currentCell) return false;
      const { cIdx, qIdx } = currentCell;
      const q = state.categories[cIdx].questions[qIdx];
      q.question = clueInput.value.trim();
      q.answer = answerInput.value.trim();
      const wantsDD = ddInput.checked;
      if (wantsDD) {
        // Enforce single DD by clearing any other flag on the board.
        for (const cat of state.categories) {
          for (const item of cat.questions) {
            item.isDailyDouble = false;
          }
        }
        q.isDailyDouble = true;
      } else {
        q.isDailyDouble = false;
      }
      save();
      renderBoard();
      renderProgress();
      return true;
    }

    function saveAndClose() {
      if (saveModal()) {
        showToast('Saved.');
        closeModal();
      }
    }

    function saveAndNext() {
      if (!saveModal()) return;
      const { cIdx, qIdx } = currentCell;
      // Advance down the column first, then wrap to the next column.
      let nextC = cIdx;
      let nextQ = qIdx + 1;
      if (nextQ >= POINT_LEVELS.length) {
        nextQ = 0;
        nextC = (cIdx + 1) % CATEGORY_COUNT;
      }
      // Reopen without closing the modal to keep the flow.
      openModal(nextC, nextQ);
    }

    modalCloseBtn.addEventListener('click', closeModal);
    modalCancelBtn.addEventListener('click', closeModal);
    modalSaveBtn.addEventListener('click', saveAndClose);
    modalSaveNextBtn.addEventListener('click', saveAndNext);
    modalBackdrop.addEventListener('click', (e) => {
      if (e.target === modalBackdrop) closeModal();
    });

    // Escape closes any open modal; Cmd/Ctrl+Enter saves within Q&A modal.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (!modalBackdrop.hidden) { closeModal(); return; }
        if (!importBackdrop.hidden) { closeImportModal(); return; }
      }
      if ((e.metaKey || e.ctrlKey) && e.key === 'Enter' && !modalBackdrop.hidden) {
        e.preventDefault();
        saveAndClose();
      }
    });

    // =============================================================================
    // Controlbar wiring
    // =============================================================================
    titleInputEl.addEventListener('input', (e) => {
      state.title = e.target.value;
      save();
    });

    document.getElementById('clearBtn').addEventListener('click', () => {
      const filledCount = countFilled();
      const msg = filledCount > 0
        ? `Clear all ${filledCount} filled questions and start over?`
        : 'Clear the board?';
      if (!window.confirm(msg)) return;
      state = makeBlankState();
      save();
      render();
      showToast('Board cleared.');
    });

    function countFilled() {
      let n = 0;
      for (const cat of state.categories) {
        for (const q of cat.questions) {
          if (isFilled(q)) n++;
        }
      }
      return n;
    }

    document.getElementById('exportJsonBtn').addEventListener('click', async () => {
      const json = JSON.stringify(state, null, 2);
      try {
        await navigator.clipboard.writeText(json);
        showToast('JSON copied to clipboard.');
      } catch (err) {
        // Fallback: dump into the import textarea so user can select + copy.
        importArea.value = json;
        importBackdrop.hidden = false;
        showToast('Copy blocked. Select the text and copy manually.', 'error');
      }
    });

    // =============================================================================
    // Import modal
    // =============================================================================
    const importBackdrop = document.getElementById('importBackdrop');
    const importArea = document.getElementById('importArea');
    const importBtn = document.getElementById('importBtn');
    const importCloseBtn = document.getElementById('importCloseBtn');
    const importCancelBtn = document.getElementById('importCancelBtn');
    const importConfirmBtn = document.getElementById('importConfirmBtn');

    function openImportModal() {
      importArea.value = '';
      importBackdrop.hidden = false;
      setTimeout(() => importArea.focus(), 20);
    }
    function closeImportModal() { importBackdrop.hidden = true; }

    importBtn.addEventListener('click', openImportModal);
    importCloseBtn.addEventListener('click', closeImportModal);
    importCancelBtn.addEventListener('click', closeImportModal);
    importBackdrop.addEventListener('click', (e) => {
      if (e.target === importBackdrop) closeImportModal();
    });
    importConfirmBtn.addEventListener('click', () => {
      const raw = importArea.value.trim();
      if (!raw) {
        showToast('Paste JSON first.', 'error');
        return;
      }
      try {
        const parsed = JSON.parse(raw);
        if (!validateState(parsed)) throw new Error('Missing title or categories.');
        state = normalizeState(parsed);
        save();
        render();
        closeImportModal();
        showToast('Board replaced.');
      } catch (err) {
        showToast('That did not parse as a valid game file.', 'error');
      }
    });

    // =============================================================================
    // Download
    // =============================================================================
    document.getElementById('downloadBtn').addEventListener('click', () => {
      const filled = countFilled();
      if (filled < CATEGORY_COUNT * POINT_LEVELS.length) {
        const total = CATEGORY_COUNT * POINT_LEVELS.length;
        const proceed = window.confirm(
          `Only ${filled} / ${total} clues are filled. Empty cells will show as blank on the projector. Download anyway?`
        );
        if (!proceed) return;
      }
      const html = buildStandaloneHtml(state);
      const filename = sanitizeFilename(state.title || 'jeopardy-game') + '.html';
      triggerDownload(html, filename);
      showToast('Downloading your game.');
    });

    function sanitizeFilename(name) {
      return String(name)
        .trim()
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '')
        .slice(0, 60) || 'jeopardy-game';
    }

    function triggerDownload(text, filename) {
      const blob = new Blob([text], { type: 'text/html;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    }

    // =============================================================================
    // Toast
    // =============================================================================
    const toastEl = document.getElementById('toast');
    let toastTimer = null;
    function showToast(msg, kind) {
      toastEl.textContent = msg;
      toastEl.classList.toggle('error', kind === 'error');
      toastEl.classList.add('show');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toastEl.classList.remove('show'), 2600);
    }

    // =============================================================================
    // Standalone HTML builder — the exported game engine.
    // =============================================================================
    function buildStandaloneHtml(data) {
      // Serialize the game data safely for injection into a <script> block.
      const dataJson = JSON.stringify(data).replace(/</g, '\\u003c');
      const gameTitle = escapeHtml(data.title || 'Classroom Jeopardy');

      // Return a fully self-contained document. No external CSS, no external JS,
      // no external fonts. Fonts fall back to system serif / sans stacks so the
      // exported file loads instantly on a projector with no internet.
      //
      // NOTE: The <style> and <script> tags in the template literals below are
      // split across concatenated strings so Astro's HTML tokenizer doesn't see
      // a bare <style> or <script> at column 0 and treat it as a real page tag.
      const OPEN_STYLE  = '<' + 'style>';
      const CLOSE_STYLE = '</' + 'style>';
      const OPEN_SCRIPT = '<' + 'script>';
      const CLOSE_SCRIPT = '</' + 'script>';
      return `<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>${gameTitle}</title>
${OPEN_STYLE}
  :root {
