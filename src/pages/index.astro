---
import Layout from '../layouts/Layout.astro';
import ProductShot from '../components/ProductShot.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ProjectRow from '../components/ProjectRow.astro';
import ContactCard from '../components/ContactCard.astro';

// Only real, shipped articles. Homepage stays honest — no dead links.
const articles = [
  {
    href: '/writing/pm-dashboard',
    category: 'Field Notes',
    title: 'I built a live progress monitoring dashboard for my special education classroom.',
    dek: 'A custom tool for logging IEP goal progress, independence, and interventions in real time — and what it changes about writing progress reports.',
    readTime: '3 min',
    date: 'July 2026',
    featured: true,
  },
  {
    href: '/writing/why-i-built-pd101',
    category: 'Framework',
    title: 'Why I built PD101',
    dek: 'Competitive debate was never built for the students who need it most. Here is how I designed a policy debate platform that meets them where they are.',
    readTime: '4 min',
    date: 'July 2026',
  },
];

// Outcome stats — only claims I can defend. Third slot removed until real.
const outcomes = [
  { stat: '12', label: 'Missions shipped, WCAG 2.1 AA' },
  { stat: '5th', label: 'Grade reading floor, throughout' },
];

const projects = [
  {
    name: 'MathMissions 101',
    description: 'A middle school numeracy platform using the same mission scaffold. Pilot planned for fall.',
    status: 'planning' as const,
  },
  {
    name: 'InclusionLab.AI',
    description: 'A teacher-facing IEP-support tool. Small, focused, no login, no data retention.',
    status: 'planning' as const,
  },
  {
    name: 'HoloSketch',
    description: 'A browser-based graphic organizer builder for SPED teachers. Ships an artifact, not a login.',
    status: 'planning' as const,
  },
  {
    name: 'Jeopardy Creator',
    description: 'Free teacher tool. Fill a form, download a self-contained playable board. No account.',
    status: 'live' as const,
    href: '/tools/jeopardy-creator',
  },
];
---

<Layout title="Austin McNair — Special Ed Teacher · Product Designer">
  <section class="hero">
    <div class="hero-copy">
      <div class="kicker">Case Study · Classroom tool</div>
      <h1>I built <em>a live progress dashboard</em> for my special education classroom.</h1>
      <p class="dek">
        A custom tool for logging IEP goal progress, independence, and interventions in the thirty
        seconds between transitions — then rolling every entry into per-student analytics I can
        drop straight into a progress report.
      </p>
      <div class="cta-row">
        <a href="#pm-dashboard" class="btn">Read the case study →</a>
        <a href="#writing" class="btn ghost">Or read the writing</a>
      </div>
    </div>

    <ProductShot
      src="/img/pm-dashboard/dashboard-full.png"
      alt="Progress Monitoring Dashboard overview: a class roster with per-student cards showing goal progress, independence, and intervention state at a glance."
      url="dashboard · overview"
      caption="Live · Classroom tool"
      eager={true}
    />
  </section>

  <section id="pm-dashboard" class="case-study">
    <div class="eyebrow">The Flagship</div>
    <h2 class="section-h">Progress Monitoring Dashboard — IEP data, in the moment.</h2>

    <div class="case-body">
      <p>
        <strong>The problem.</strong> In special education, data collection usually happens long
        after the lesson ends. Vague memory produces vague records, and vague data makes writing
        meaningful IEP progress reports an uphill battle.
      </p>
      <p>
        <strong>What I built.</strong> A live dashboard where I log goal progress, independence
        level, and intervention type in the thirty seconds between transitions. One tap per data
        point. Every entry is timestamped and rolls up into per-student analytics I can drop
        straight into a progress report.
      </p>
      <p>
        <strong>How it changes IEP writing.</strong> Instead of reconstructing a quarter from
        memory, I open the analytics view and read the pattern the data already tells. The
        anecdote and the number arrive together.
      </p>

      <figure class="case-shot">
        <ProductShot
          src="/img/pm-dashboard/dashboard-analytics.png"
          alt="Per-student analytics view from the Progress Monitoring Dashboard, showing goal-progress trends, independence levels, and intervention counts over time."
          url="dashboard · student analytics"
          caption="Analytics · Per-student rollup"
        />
        <figcaption>
          The per-student rollup view: goal-progress trends, independence levels, and intervention
          counts over time — the numbers I drop straight into a progress report.
        </figcaption>
      </figure>

      <p><a href="/writing/pm-dashboard">Read the field notes →</a></p>
    </div>
  </section>

  <section id="pd101" class="case-study">
    <div class="eyebrow">Also Shipped</div>
    <h2 class="section-h">policydebate101.com — an accessible debate curriculum, shipped.</h2>

    <div class="case-body">
      <p>
        <strong>The problem.</strong> Policy debate is the highest-leverage academic activity most
        middle schoolers will never touch. The barrier is not intelligence — it is an intimidating
        vocabulary, a culture that assumes you already know the format, and materials written for
        high-school varsity. My sixth graders needed a runway.
      </p>
      <p>
        <strong>What I built.</strong> A twelve-mission, self-paced platform where a "Support
        Commander" narrator walks the student through their first cross-examination. Graphic
        organizers are interactive; the reading floor is 5th grade; the tone is warm, not
        corporate. Every screen was audited for cognitive load — one idea per screen, one action
        per screen.
      </p>
      <p>
        <strong>How it is used.</strong> Chicago Debates uses it as summer-institute pre-work. My
        co-teacher and I use it as differentiated in-class instruction — students who need the
        scaffolding get missions, students who do not move to live rounds sooner.
      </p>

      <figure class="case-shot">
        <ProductShot
          src="/img/pd101-mission-control.png"
          alt="policydebate101.com Mission Control screen: Support Commander avatar, welcome message, Cadet rank, and the first launchable mission."
          url="policydebate101.com/missions"
          caption="Live · Mission Control"
        />
        <figcaption>
          Mission Control: where a student meets the Support Commander, sees her rank, and launches
          her first mission. Every screen holds one idea, one action.
        </figcaption>
      </figure>

      <figure class="case-shot">
        <ProductShot
          src="/img/pd101-lessons.png"
          alt="policydebate101.com Lesson resource view: sidebar list of lesson slide decks, embedded slide viewer, and a magenta download graphic organizer button."
          url="policydebate101.com/resources/lessons"
          caption="Teacher-facing · Lesson decks & organizers"
        />
        <figcaption>
          The Debater Resources view: every slide deck used in class, every worksheet as a PDF
          download. This is the teacher-facing side of the same platform — same visual language,
          different vocabulary.
        </figcaption>
      </figure>

      <div class="outcomes">
        {outcomes.map(({ stat, label }) => (
          <div class="outcome">
            <div class="stat">{stat}</div>
            <div class="stat-label">{label}</div>
          </div>
        ))}
      </div>

      <p><a href="/work/policydebate101">Read the full case study →</a></p>
    </div>
  </section>

  <section id="writing">
    <div class="eyebrow">Selected Writing</div>
    <h2 class="section-h">Field notes from a Chicago SPED classroom.</h2>
    <div class="article-list">
      {articles.map((a) => <ArticleCard {...a} />)}
    </div>
  </section>

  <section id="work">
    <div class="eyebrow">Other Work</div>
    <h2 class="section-h">Products, in various states of shipped.</h2>
    <div class="project-list">
      {projects.map((p) => <ProjectRow {...p} />)}
    </div>
  </section>

  <section id="about">
    <div class="eyebrow">About</div>
    <h2 class="section-h">Special education teacher. Product designer. In Chicago.</h2>
    <div class="about-body">
      <p>
        I am a special education teacher in Chicago, IL. Are you hiring? Email me{' '}
        <a href="mailto:austin@austinmcnair.com">austin@austinmcnair.com</a>.
      </p>
    </div>
  </section>

  <ContactCard />
</Layout>

<style>
  section {
    max-width: var(--site-max);
    margin: 0 auto;
    padding: 72px var(--edge-pad);
    border-top: 1px solid var(--line);
  }

  /* HERO */
  .hero {
    max-width: var(--site-max);
    margin: 0 auto;
    padding: 96px var(--edge-pad) 72px;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 56px;
    align-items: center;
    border-top: none;
  }
  .hero-copy .kicker {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .hero-copy .kicker::before {
    content: '';
    width: 32px;
    height: 1px;
    background: var(--text-faint);
  }
  .hero-copy h1 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(38px, 5.5vw, 60px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0 0 24px;
  }
  .hero-copy h1 em {
    font-style: italic;
    color: var(--cyan);
    font-weight: 500;
  }
  .hero-copy .dek {
    font-family: var(--font-serif);
    font-size: 20px;
    line-height: 1.55;
    color: var(--text-dim);
    max-width: 44ch;
    margin: 0 0 32px;
  }
  .hero-copy .cta-row {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  /* CASE STUDY BODY */
  .case-body {
    max-width: var(--content-max);
  }
  .case-body p {
    font-family: var(--font-serif);
    font-size: 19px;
    line-height: 1.7;
    color: var(--text-dim);
    margin: 0 0 20px;
  }
  .case-body p strong {
    color: var(--text);
    font-weight: 500;
  }
  .case-body p a {
    color: var(--cyan);
  }

  .case-shot {
    margin: 40px 0;
  }
  .case-shot figcaption {
    margin-top: 12px;
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--text-faint);
    letter-spacing: 0.02em;
    line-height: 1.5;
    max-width: 62ch;
  }

  .outcomes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 32px;
    margin: 40px 0;
    padding: 32px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .outcome .stat {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 34px;
    color: var(--text);
    letter-spacing: -0.01em;
    margin-bottom: 6px;
    line-height: 1.1;
  }
  .outcome .stat-label {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--text-faint);
  }

  /* ABOUT */
  .about-body {
    max-width: var(--content-max);
  }
  .about-body p {
    font-family: var(--font-serif);
    font-size: 19px;
    line-height: 1.7;
    color: var(--text-dim);
    margin: 0 0 20px;
  }
  .about-body p em {
    color: var(--cyan);
    font-style: italic;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 48px;
      padding: 56px var(--edge-pad) 40px;
    }
    .outcomes { grid-template-columns: 1fr; gap: 20px; }
  }
</style>
