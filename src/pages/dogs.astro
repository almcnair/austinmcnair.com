---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Dogs | Austin McNair" description="A slideshow of my dogs.">
  <main style="max-width: 1200px; margin: 0 auto; padding: 4rem 2rem; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 70vh;">
    <h1 style="font-size: 2.5rem; margin-bottom: 0.5rem; text-align: center;">The Dogs</h1>
    <p style="color: var(--text-dim); margin-bottom: 3rem; text-align: center;">The most important members of the team.</p>
    
    <div style="width: 100%; max-width: 900px; border-radius: 12px; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.1); background: #000; display: flex; aspect-ratio: 16/9;">
      <video 
        src="/dogs.mp4" 
        autoplay 
        loop 
        muted 
        playsinline
        style="width: 100%; height: 100%; object-fit: cover;"
      ></video>
    </div>
  </main>
</Layout>