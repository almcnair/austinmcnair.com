---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => !data.draft || import.meta.env.DEV);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'writing'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const dateFmt = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={`${post.data.title} — Austin McNair`} description={post.data.dek}>
  <article class="article-page">
    <header>
      <div class="cat">{post.data.category}</div>
      {post.data.titleHtml
        ? <h1 set:html={post.data.titleHtml} />
        : <h1>{post.data.title}</h1>}
      <p class="dek">{post.data.dek}</p>
      <div class="meta">
        <span>By Austin McNair</span>
        <span aria-hidden="true">·</span>
        <span>{post.data.readTime}</span>
        <span aria-hidden="true">·</span>
        <time datetime={post.data.date.toISOString()}>{dateFmt}</time>
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>

    <a href="/#writing" class="back">← Back to writing</a>
  </article>
</Layout>

<style>
  .article-page {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 72px var(--edge-pad) 96px;
  }

  header { margin-bottom: 56px; }

  .cat {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--warm);
    margin-bottom: 24px;
  }

  h1 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(36px, 5vw, 56px);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 24px;
  }
  h1 :global(em) { font-style: italic; color: var(--cyan); }

  .dek {
    font-family: var(--font-serif);
    font-size: 22px;
    line-height: 1.5;
    color: var(--text-dim);
    margin: 0 0 32px;
    max-width: 44ch;
  }

  .meta {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text-faint);
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }

  /* Prose styling for MDX body */
  .prose :global(p) {
    font-family: var(--font-serif);
    font-size: 19px;
    line-height: 1.7;
    color: var(--text);
    margin: 0 0 24px;
  }
  .prose :global(p em) { font-style: italic; color: var(--cyan); }
  .prose :global(h2) {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 30px;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin: 56px 0 20px;
  }
  .prose :global(h3) {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 24px;
    margin: 40px 0 16px;
  }
  .prose :global(a) { color: var(--cyan); border-bottom: 1px solid rgba(34,211,238,0.4); }
  .prose :global(a:hover) { border-bottom-color: var(--cyan); }
  .prose :global(strong) { color: var(--text); font-weight: 600; }
  .prose :global(ul),
  .prose :global(ol) {
    font-family: var(--font-serif);
    font-size: 19px;
    line-height: 1.7;
    color: var(--text);
    padding-left: 24px;
    margin: 0 0 24px;
  }
  .prose :global(li) { margin-bottom: 8px; }
  .prose :global(blockquote) {
    border-left: 3px solid var(--cyan);
    padding: 4px 0 4px 24px;
    margin: 32px 0;
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--text-dim);
  }
  .prose :global(blockquote strong) {
    font-family: var(--font-sans);
    font-style: normal;
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cyan);
    display: block;
    margin-bottom: 8px;
  }
  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--line);
    margin: 48px 0;
  }

  /* Metric callouts — dividers, not cards (Brand Guide §4.4) */
  .prose :global(ul.metric-list) {
    list-style: none;
    padding: 0;
    margin: 0 0 32px;
    border-top: 1px solid var(--line);
  }
  .prose :global(ul.metric-list li) {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 24px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-serif);
    font-size: 18px;
    line-height: 1.55;
    color: var(--text);
    margin: 0;
  }
  .prose :global(ul.metric-list .tag) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.14em;
    color: var(--cyan);
    padding-top: 4px;
  }
  @media (max-width: 620px) {
    .prose :global(ul.metric-list li) {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }

  /* Inline figure — in the 780px prose column */
  .prose :global(figure.inline-figure) {
    margin: 40px 0 48px;
  }
  .prose :global(figure.inline-figure .frame) {
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    background: var(--panel);
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.6);
  }
  .prose :global(figure.inline-figure img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .prose :global(figure.inline-figure figcaption) {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--text-faint);
    margin-top: 14px;
    letter-spacing: 0.01em;
    max-width: 62ch;
  }
  .prose :global(figure.inline-figure figcaption strong) {
    font-family: var(--font-sans);
    color: var(--text-dim);
    font-weight: 600;
    margin-right: 6px;
  }

  /* Lede figure — breakout wider than the prose column, up to site-max */
  .prose :global(figure.lede-figure) {
    /* Escape the 780px prose column and expand to site-max (1080px). */
    width: calc(100vw - (2 * var(--edge-pad)));
    max-width: var(--site-max);
    margin-left: calc(50% - min(50vw, var(--site-max) / 2) + var(--edge-pad));
    margin-right: 0;
    margin-top: -8px;
    margin-bottom: 56px;
  }
  .prose :global(figure.lede-figure .frame) {
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    background: var(--panel);
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.6);
  }
  .prose :global(figure.lede-figure img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .prose :global(figure.lede-figure figcaption) {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--text-faint);
    margin-top: 14px;
    letter-spacing: 0.01em;
    max-width: 62ch;
  }
  .prose :global(figure.lede-figure figcaption strong) {
    font-family: var(--font-sans);
    color: var(--text-dim);
    font-weight: 600;
    margin-right: 6px;
  }
  @media (max-width: 960px) {
    .prose :global(figure.lede-figure) {
      width: 100%;
      margin-left: 0;
      margin-right: 0;
    }
  }

  .back {
    display: inline-block;
    margin-top: 64px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--text-dim);
    border: none;
  }
  .back:hover { color: var(--cyan); }
</style>
